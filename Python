Using a for Loop (Iterative Approach)
def calculate_factorial_loop(num):
    if num < 0:
        return "Factorial is not defined for negative numbers"
    elif num == 0:
        return 1
    else:
        factorial = 1
        for i in range(1, num + 1):
            factorial *= i
        return factorial

# Example usage:
number = 5
print(f"The factorial of {number} is {calculate_factorial_loop(number)}") # Output: The factorial of 5 is 120
